# Copy to .env (in the app folder, NOT in the web folder) and fill in. Quote values with spaces or #.

# --- Site ---
BASE_URL=https://drive.readthemissinglink.net
TIMEZONE=Asia/Kolkata

# --- Database (Hostinger MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u604557415_Asdfg1
DB_USER=u604557415_tmlAdmin
DB_PASSWORD=""

# --- File storage: outside the web folder ---
STORAGE_DIR=/home/u604557415/alumnimag-storage
MAX_UPLOAD_MB=40

# --- First administrator (created on first start only) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=""
ADMIN_NAME=Administrator

# --- AI review: Google Gemini and/or Groq (set at least one key; choose the main one in Settings) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- AI images (Cloudflare Workers AI, free daily allowance): dashboard > AI > Workers AI > Use REST API ---
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- Email (Gmail: use an App Password, not the normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alumnikarunya@gmail.com
SMTP_PASS=""
SMTP_FROM=alumnikarunya@gmail.com

# --- Review rules (also editable in Settings) ---
REVIEW_DAYS=2
REVIEW_CC=alumnikarunya@gmail.com

# --- WordPress (also editable in Settings) ---
WP_URL=https://readthemissinglink.net
WP_USER=
WP_APP_PASSWORD=""
