# drive.readthemissinglink.net - send every request that is not a real file to index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^app-root\.php$ - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Never serve configuration or code files that are not meant for the browser
<FilesMatch "(^\.env|\.ini|\.log|\.sh|\.sql|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
